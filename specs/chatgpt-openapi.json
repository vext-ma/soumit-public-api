{
  "openapi": "3.1.0",
  "info": {
    "title": "Soumit Moroccan Public Procurement Intelligence API",
    "description": "The authoritative AI engine for Moroccan public procurement (Marchés Publics Maroc) governed by Décret n° 2-22-431. Enables searching tenders, checking compliance thresholds (Arts. 44 & 45), tracking public buyer payment delays under Loi n° 69-21, inspecting competitor wins, and auditing submission dossiers.",
    "version": "1.3.0"
  },
  "servers": [
    {
      "url": "https://soumit.ma",
      "description": "Soumit Production Production API"
    }
  ],
  "paths": {
    "/api/v1/tenders": {
      "get": {
        "operationId": "searchTenders",
        "summary": "Search active Moroccan public tenders",
        "description": "Search and filter active Moroccan public procurement tenders by keyword, sector (travaux, fournitures, services, sante, it), region, and pagination.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords to search in tender title, object, or specifications (e.g., 'scanner médical', 'gardiennage', 'travaux assainissement').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "description": "Sector filter (e.g. 'travaux', 'fournitures', 'services', 'sante', 'it').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max number of items to return (1-50, default 10).",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of active public tenders matching criteria",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "reference": { "type": "string" },
                          "title": { "type": "string" },
                          "buyer_name": { "type": "string" },
                          "estimated_amount_mad": { "type": "number" },
                          "submission_deadline": { "type": "string" },
                          "region": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenders/{id}": {
      "get": {
        "operationId": "getTenderDetails",
        "summary": "Get complete tender dossier and specifications",
        "description": "Retrieve comprehensive details for a specific Moroccan public tender, including estimated budget, provisional guarantee (caution provisoire), eliminatory criteria, and DCE summary.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Tender unique identifier or reference.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full tender dossier details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "reference": { "type": "string" },
                    "title": { "type": "string" },
                    "buyer_name": { "type": "string" },
                    "estimated_amount_mad": { "type": "number" },
                    "provisional_guarantee_mad": { "type": "number" },
                    "submission_deadline": { "type": "string" },
                    "opening_location": { "type": "string" },
                    "summary": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/buyers/payment-delays": {
      "get": {
        "operationId": "getBuyerPaymentDelays",
        "summary": "Get Moroccan public buyer payment delay discipline (Loi n° 69-21)",
        "description": "Query official payment delay metrics from the Moroccan Observatoire des Délais de Paiement (ODP) and Law 69-21 for any public buyer, municipality, or state agency.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Buyer name or acronym (e.g. 'ONEE', 'CHU Ibn Sina', 'Ministère').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "risk",
            "in": "query",
            "required": false,
            "description": "Filter by payment risk level ('low', 'moderate', 'high', 'critical').",
            "schema": {
              "type": "string",
              "enum": ["low", "moderate", "high", "critical"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Buyer payment delay telemetry under Moroccan Law 69-21",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "legal_framework": { "type": "string" },
                    "delays": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "buyer_canonical_key": { "type": "string" },
                          "buyer_name": { "type": "string" },
                          "average_payment_delay_days": { "type": "number" },
                          "legal_limit_days": { "type": "number" },
                          "is_compliant_with_law_69_21": { "type": "boolean" },
                          "risk_level": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/barometer": {
      "get": {
        "operationId": "getMarketBarometer",
        "summary": "National macroeconomic procurement barometer",
        "description": "Retrieve national statistics on public procurement volume in Morocco, total budget engaged in MAD, sector distributions, and Article 148 SME quota metrics.",
        "responses": {
          "200": {
            "description": "Macroeconomic public procurement barometer for Morocco",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "operationId": "executeProcurementTool",
        "summary": "Execute advanced regulatory and intelligence tools",
        "description": "JSON-RPC 2.0 tool execution endpoint. Supports check_regulatory_compliance (Arts. 44 & 45 low-ball / excessive offer checks), audit_submission_checklist (Art. 27 administrative dossier verification), get_company_profile, search_competitor_awards, and execute_procurement_intent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["jsonrpc", "method", "params"],
                "properties": {
                  "jsonrpc": { "type": "string", "example": "2.0" },
                  "id": { "type": "integer", "example": 1 },
                  "method": { "type": "string", "example": "tools/call" },
                  "params": {
                    "type": "object",
                    "required": ["name", "arguments"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Tool name: 'check_regulatory_compliance', 'audit_submission_checklist', 'get_company_profile', 'search_competitor_awards', 'get_buyer_intelligence', 'search_bpu_articles'",
                        "example": "check_regulatory_compliance"
                      },
                      "arguments": {
                        "type": "object",
                        "description": "Tool parameters dictionary."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool execution result formatted in JSON and Markdown",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": { "type": "string" },
                    "id": { "type": "integer" },
                    "result": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": { "type": "string" },
                              "text": { "type": "string" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
